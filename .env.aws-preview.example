# Supermarket.ie — AWS preview environment variable template (NAMES ONLY).
# No secret values are stored here. In AWS these are injected at runtime from
# SSM Parameter Store / Secrets Manager into the ECS task or App Runner service.
#
# SAFETY: the preview MUST use an isolated/read-only Supabase credential and must
# NOT use the production service-role key. Keep all worker flags unset/false and
# create NO schedules so no scraping, price renewal, or email can occur.

# ---- Core application ----
# Supabase project URL (preview project/branch, NOT production).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (public).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# PREVIEW: a RESTRICTED, READ-ONLY key (or a branch/clone key). NOT the prod service-role key.
SUPABASE_SERVICE_ROLE_KEY=

# In-app read-only enforcement (defence in depth on top of the restricted key).
# APP_ENV=preview already forces this on; set true to force it in any env too.
SUPABASE_READ_ONLY=true

# JWT / magic-link signing secrets (use preview-only values, not prod).
MAGIC_LINK_SECRET=
VENDOR_MAGIC_LINK_SECRET=

# Shared bearer secret for cron + worker trigger routes.
CRON_SECRET=
# Guards the on-demand /api/revalidate route.
REVALIDATE_SECRET=

# Canonical URLs for links/metadata. In preview, set to the AWS-generated URL
# (App Runner default domain or the ALB/CloudFront preview hostname).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL=

# ---- External integrations ----
# Resend email API key. Keep EMAIL effectively OFF in preview by not scheduling
# the email crons (optionally use a restricted/sandbox key).
RESEND_API_KEY=
# Anthropic key for the Eve agent.
ANTHROPIC_API_KEY=
# ScrapingBee key for Tesco (preview: leave UNSET — Tesco egress stays disabled).
SCRAPINGBEE_API_KEY=
# Google Analytics (optional in preview).
GOOGLE_ANALYTICS_CREDENTIALS_JSON=
GOOGLE_ANALYTICS_PROPERTY_ID=

# ---- Platform replacement for Vercel ----
# Replaces reads of VERCEL_ENV in the app (page.tsx, preview/guest-shop).
# NOTE: a small code change is needed to read APP_ENV where VERCEL_ENV is read.
APP_ENV=preview

# ---- Eve companion server ----
# Port the Eve agent server listens on and that Next proxies /eve/v1/* to.
# MUST be identical at BUILD time and RUN time (the rewrite target is baked
# into .next at build). Default 4274; leave as-is unless you have a conflict.
EVE_NEXT_PRODUCTION_PORT=4274

# ---- Retailer collection safeguards: ALL DISABLED in preview ----
# Leave every flag below UNSET or false. Do not create cron/EventBridge
# schedules in preview. Do not populate the Tesco egress pool.
TESCO_VERCEL_WORKER_ENABLED=false
# TESCO_VERCEL_RUN_LIMIT=
# TESCO_VERCEL_BATCH_SIZE=
# TESCO_VERCEL_BATCH_STAGGER_SECONDS=
# TESCO_VERCEL_PRODUCT_SPACING_MS=
DUNNES_VERCEL_WORKER_ENABLED=false
# DUNNES_VERCEL_RUN_LIMIT=
# DUNNES_VERCEL_BATCH_SIZE=
# DUNNES_VERCEL_BATCH_STAGGER_SECONDS=
SUPERVALU_VERCEL_WORKER_ENABLED=false
# SUPERVALU_VERCEL_RUN_LIMIT=
# SUPERVALU_VERCEL_BATCH_SIZE=
# SUPERVALU_VERCEL_BATCH_STAGGER_SECONDS=
